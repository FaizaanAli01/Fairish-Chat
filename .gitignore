# ==============================================================================
# Fairish Chat — .gitignore
# ==============================================================================

# Compiled & Build outputs
target/
dist/
build/
*.class
*.jar
*.war

# Node.js
node_modules/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secrets (NEVER COMMIT SECRETS)
.env
.env.*
.env.local
.env.*.local
*.env
**/.env
**/*.env
backend/.env
frontend/.env

# Keep the non-secret environment templates tracked
!.env.example
!**/.env.example

# IDE & Editor artifacts
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Log files
*.log
logs/

# Temporary / testing
coverage/
.system_generated/


backend/apache-maven-*/
