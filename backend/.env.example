# ==============================================================================
# FAIRISH CHAT BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit production secrets to version control.
# ==============================================================================

# Server Port
PORT=8080

# Spring profile. Set to "prod" in production to enable strict production
# settings (INFO logging, secure error responses, required CORS origins).
# SPRING_PROFILES_ACTIVE=prod

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/fairish_chat
MONGODB_DATABASE=fairish_chat

# JWT Authentication Secret (REQUIRED)
# Must be at least 32 bytes (256 bits). The backend refuses to start if this is
# missing or too short. Generate a unique value for each environment, e.g.:
#   openssl rand -base64 48
JWT_SECRET=

# JWT Token Expiration Time in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# CORS Allowed Origins (comma-separated, exact origins)
# Development example (localhost). Production must use the real frontend
# origin(s), e.g. https://app.example.com. Wildcards are not allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ------------------------------------------------------------------------------
# Avatar storage (S3-compatible)
# ------------------------------------------------------------------------------
# Local development uses MinIO. Production uses Cloudflare R2.
# The bucket is private; avatars are only served through the authenticated
# backend proxy at GET /api/users/{id}/avatar.
#
# Set AVATAR_STORAGE_ENABLED=false to boot without MinIO/R2 (avatar endpoints
# then return 503). Production defaults to enabled and fails fast without
# credentials.
#
# Local MinIO example (docker compose):
#   AVATAR_STORAGE_ENDPOINT=http://localhost:9000
#   AVATAR_STORAGE_REGION=us-east-1
#   AVATAR_STORAGE_PATH_STYLE_ACCESS=true
#   AVATAR_STORAGE_CREATE_BUCKET=true
#
# Cloudflare R2 example (production):
#   AVATAR_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   AVATAR_STORAGE_REGION=auto
#   AVATAR_STORAGE_PATH_STYLE_ACCESS=false
#   AVATAR_STORAGE_CREATE_BUCKET=false
AVATAR_STORAGE_ENABLED=true
AVATAR_STORAGE_ENDPOINT=http://localhost:9000
AVATAR_STORAGE_REGION=us-east-1
AVATAR_STORAGE_BUCKET=fairish-avatars
AVATAR_STORAGE_ACCESS_KEY=
AVATAR_STORAGE_SECRET_KEY=
AVATAR_STORAGE_PATH_STYLE_ACCESS=true
AVATAR_STORAGE_CREATE_BUCKET=true

# Upload constraints (5 MB, 512x512 output)
AVATAR_MAX_UPLOAD_BYTES=5242880
AVATAR_MAX_REQUEST_BYTES=6MB
AVATAR_OUTPUT_SIZE=512
