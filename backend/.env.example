# ==============================================================================
# FAIRISH CHAT BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit production secrets to version control.
# ==============================================================================

# Server Port
PORT=8080

# Spring profile. Set to "prod" in production to enable strict production
# settings (INFO logging, secure error responses, required CORS origins).
# SPRING_PROFILES_ACTIVE=prod

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/fairish_chat
MONGODB_DATABASE=fairish_chat

# MongoDB transactions require a replica set (MongoDB Atlas) or a mongos router.
# The bundled docker-compose.yml runs a standalone MongoDB, which cannot start
# transactions, so they are disabled for the default local setup. Delete this
# line (or set it to true) when MONGODB_URI points at Atlas or another replica set.
SPRING_DATA_MONGODB_TRANSACTION_ENABLED=false

# JWT Authentication Secret (REQUIRED)
# Must be at least 32 bytes (256 bits). The backend refuses to start if this is
# missing or too short. Generate a unique value for each environment, e.g.:
#   openssl rand -base64 48
JWT_SECRET=

# JWT Token Expiration Time in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# Message encryption at rest (AES-256-GCM)
# ------------------------------------------------------------------------------
# Required unless MESSAGE_ENCRYPTION_ENABLED=false. The key must decode to
# exactly 32 bytes (256 bits). Generate one per environment, for example:
#   openssl rand -base64 32
# Never reuse a key across environments and never commit a real key.
#
# Key rotation: set a new active key and move the old one (or several) into
# MESSAGE_ENCRYPTION_PREVIOUS_KEYS as comma-separated keyId:base64Key entries.
# Previous keys are used only for decryption, so existing messages stay readable.
MESSAGE_ENCRYPTION_ENABLED=true
MESSAGE_ENCRYPTION_KEY_ID=v1
MESSAGE_ENCRYPTION_KEY=
MESSAGE_ENCRYPTION_PREVIOUS_KEYS=

# One-off legacy plaintext migration. Disabled by default; nothing runs unless
# this is explicitly enabled. Always run mode=dry-run first. See README.
MESSAGE_ENCRYPTION_MIGRATION_ENABLED=false
MESSAGE_ENCRYPTION_MIGRATION_MODE=dry-run
MESSAGE_ENCRYPTION_MIGRATION_BATCH_SIZE=100

# CORS Allowed Origins (comma-separated, exact origins)
# Development example (localhost). Production must use the real frontend
# origin(s), e.g. https://app.example.com. Wildcards are not allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ------------------------------------------------------------------------------
# Avatar storage (S3-compatible)
# ------------------------------------------------------------------------------
# Local development uses MinIO. Production uses Cloudflare R2.
# The bucket is private; avatars are only served through the authenticated
# backend proxy at GET /api/users/{id}/avatar.
#
# Set AVATAR_STORAGE_ENABLED=false to boot without MinIO/R2 (avatar endpoints
# then return 503). Production defaults to enabled and fails fast without
# credentials.
#
# Local development (MinIO, started with `docker compose up -d` from the repo
# root). The values below match docker-compose.yml and work after copying this
# file to .env. They are local dev credentials only — never reuse them in
# production.
AVATAR_STORAGE_ENABLED=true
AVATAR_STORAGE_ENDPOINT=http://localhost:9000
AVATAR_STORAGE_REGION=us-east-1
AVATAR_STORAGE_BUCKET=fairish-avatars
AVATAR_STORAGE_ACCESS_KEY=fairish-minio
AVATAR_STORAGE_SECRET_KEY=fairish-minio-dev-secret
AVATAR_STORAGE_PATH_STYLE_ACCESS=true
AVATAR_STORAGE_CREATE_BUCKET=true

# Cloudflare R2 (production) uses the same variables with different values:
#   AVATAR_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   AVATAR_STORAGE_REGION=auto
#   AVATAR_STORAGE_ACCESS_KEY=<r2-access-key>
#   AVATAR_STORAGE_SECRET_KEY=<r2-secret-key>
#   AVATAR_STORAGE_PATH_STYLE_ACCESS=false
#   AVATAR_STORAGE_CREATE_BUCKET=false   (provision the bucket out of band)

# Upload constraints (5 MB, 512x512 output)
AVATAR_MAX_UPLOAD_BYTES=5242880
AVATAR_MAX_REQUEST_BYTES=6MB
AVATAR_OUTPUT_SIZE=512
