# ==============================================================================
# FAIRISH CHAT FRONTEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and adjust for your environment.
# VITE_* values are public and embedded in the client bundle. NEVER put secrets here.
# ==============================================================================

# Required. Backend REST API base URL (no trailing slash).
# Development example:
VITE_API_BASE_URL=http://localhost:8080/api
# Production example (HTTPS, never localhost):
# VITE_API_BASE_URL=https://api.example.com/api

# Optional. WebSocket base URL. If omitted, it is derived from
# VITE_API_BASE_URL as wss://<api-host>/ws (or ws:// for http).
# Production example (never localhost):
# VITE_WS_URL=wss://api.example.com/ws
